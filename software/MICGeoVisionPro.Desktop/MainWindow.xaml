<Window x:Class="MICGeoVisionPro.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MIC GeoVision Pro" Height="780" Width="1360" MinHeight="640" MinWidth="1100"
        WindowStartupLocation="CenterScreen" Background="#07141d" Language="fr-FR">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="#112230" />
            <Setter Property="Foreground" Value="#edf7ff" />
            <Setter Property="BorderBrush" Value="#2c4b65" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Background" Value="#0b1724" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#1d3549" />
                                <Setter Property="Foreground" Value="#6f8aa3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ViewTabButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="#0ea5e9" />
                    <Setter Property="Foreground" Value="#041821" />
                    <Setter Property="BorderBrush" Value="#0ea5e9" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Background" Value="#112230" />
            <Setter Property="Foreground" Value="#edf7ff" />
            <Setter Property="BorderBrush" Value="#2c4b65" />
        </Style>

        <Style x:Key="PanelLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#a8c1d9" />
        </Style>

        <Style x:Key="GridEditingBox" TargetType="TextBox">
            <Setter Property="Background" Value="#112230" />
            <Setter Property="Foreground" Value="#edf7ff" />
            <Setter Property="BorderBrush" Value="#0ea5e9" />
            <Setter Property="Padding" Value="2" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="54" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0b1724" BorderBrush="#2c4b65" BorderThickness="0,0,0,1">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" Background="#0ea5e9" CornerRadius="8" VerticalAlignment="Center">
                        <TextBlock Text="MIC" FontWeight="Bold" Foreground="#041821" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10"/>
                    </Border>
                    <TextBlock Text="MIC GeoVision Pro" Margin="12,0,0,0" FontSize="20" FontWeight="Bold" Foreground="#edf7ff" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="New Borehole" Command="{Binding AddBoreholeCommand}" Style="{StaticResource ToolButton}" Width="120" />
                    <Button Content="Add Log" Command="{Binding AddLogCommand}" Style="{StaticResource ToolButton}" Width="100" />
                    <Button Content="Save" Command="{Binding SaveProjectCommand}" Style="{StaticResource ToolButton}" Width="90" />
                    <Button Content="Import CSV" Command="{Binding ImportCsvCommand}" Style="{StaticResource ToolButton}" Width="110" />
                    <Button Content="Export CSV" Command="{Binding ExportCsvCommand}" Style="{StaticResource ToolButton}" Width="100" />
                    <Button Content="Export PNG" Click="ExportPng_Click" Style="{StaticResource ToolButton}" Width="100" Margin="0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <Border Background="#0d1b2a" BorderBrush="#2c4b65" BorderThickness="0,0,1,0">
                <StackPanel Margin="12,12,10,12">
                    <TextBlock Text="PROJECT" Style="{StaticResource PanelLabel}" Margin="0,0,0,8" />
                    <TextBox Text="{Binding ProjectName}" Style="{StaticResource FieldBox}" Margin="0,0,0,18" />

                    <TextBlock Text="BOREHOLES" Style="{StaticResource PanelLabel}" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding BoreholesCount, StringFormat='Total: {0}'}" Margin="0,0,0,6" Foreground="#edf7ff"/>
                    <ListBox ItemsSource="{Binding Boreholes}" SelectedItem="{Binding SelectedBorehole, Mode=TwoWay}"
                             Height="150" Background="#0e1a29" BorderBrush="#2c4b65" Foreground="#edf7ff" DisplayMemberPath="Name"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,18">
                        <Button Content="New" Command="{Binding AddBoreholeCommand}" Style="{StaticResource ToolButton}" Width="70" />
                        <Button Content="Delete" Command="{Binding DeleteBoreholeCommand}" Style="{StaticResource ToolButton}" Width="82" Margin="0" />
                    </StackPanel>

                    <TextBlock Text="LOGS" Style="{StaticResource PanelLabel}" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding LogsCount, StringFormat='Logs: {0}'}" Margin="0,0,0,6" Foreground="#edf7ff"/>
                    <ListBox ItemsSource="{Binding Logs}" SelectedItem="{Binding SelectedLog, Mode=TwoWay}"
                             Height="150" Background="#0e1a29" BorderBrush="#2c4b65" Foreground="#edf7ff" DisplayMemberPath="Name"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="New" Command="{Binding AddLogCommand}" Style="{StaticResource ToolButton}" Width="70" />
                        <Button Content="Delete" Command="{Binding DeleteLogCommand}" Style="{StaticResource ToolButton}" Width="82" Margin="0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1" Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Background="#112230" BorderBrush="#2c4b65" BorderThickness="1" CornerRadius="10" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="CURRENT VIEW" Style="{StaticResource PanelLabel}" />
                            <TextBlock Text="{Binding ActiveViewTitle}" FontSize="24" FontWeight="Bold" Foreground="#edf7ff" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding BoreholeSummary}" Foreground="#a8c1d9" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="Borehole" Width="90" Tag="{Binding IsBoreholeViewActive}"
                                    Command="{Binding ShowBoreholeViewCommand}"
                                    Style="{StaticResource ViewTabButton}" Margin="0,0,8,0" />
                            <Button Content="Map" Width="70" Tag="{Binding IsMapViewActive}"
                                    Command="{Binding ShowMapViewCommand}"
                                    Style="{StaticResource ViewTabButton}" Margin="0" />
                            <Button Content="Cross Section" Width="110" Tag="{Binding IsSectionViewActive}"
                                    Command="{Binding ShowCrossSectionViewCommand}"
                                    Style="{StaticResource ViewTabButton}" Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid x:Name="ViewHost" Grid.Row="1" Margin="0,12,0,0">
                <Border Visibility="{Binding IsBoreholeViewActive, Converter={StaticResource BoolToVisibility}}"
                        Background="#0f1d2b" BorderBrush="#2c4b65" BorderThickness="1" CornerRadius="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Background="#122840" BorderBrush="#2c4b65" BorderThickness="0,0,0,1" Padding="12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Depth axis in metres" Foreground="#a8c1d9" VerticalAlignment="Center"/>
                                <TextBlock Text="·" Foreground="#2c4b65" Margin="8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Edit layers in the LITHOLOGY LAYERS grid" Foreground="#a8c1d9" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <Grid Margin="24,16,24,16" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <Canvas Width="430" Height="480">
                                    <TextBlock Text="Depth (m)" Foreground="#a8c1d9" FontSize="11" Canvas.Left="4" Canvas.Top="0"/>

                                    <Line X1="62" Y1="20" X2="62" Y2="460" Stroke="#dfeaf5" StrokeThickness="2"
                                          Visibility="{Binding HasScale, Converter={StaticResource BoolToVisibility}}"/>

                                    <Border Canvas.Left="72" Canvas.Top="20" Width="180" Height="440"
                                            BorderBrush="#dfeaf5" BorderThickness="1" Background="#0b1a27"
                                            Visibility="{Binding HasScale, Converter={StaticResource BoolToVisibility}}"/>

                                    <ItemsControl ItemsSource="{Binding DepthTicks}" Canvas.Left="0" Canvas.Top="20"
                                                  Width="430" Height="440"
                                                  Visibility="{Binding HasScale, Converter={StaticResource BoolToVisibility}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="0" />
                                                <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Label}" Width="52" TextAlignment="Right"
                                                               Foreground="#a8c1d9" FontSize="11" VerticalAlignment="Center"/>
                                                    <Line X1="0" Y1="0" X2="10" Y2="0" Stroke="#89a9c9"
                                                          StrokeThickness="1" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ItemsControl ItemsSource="{Binding Segments}" Canvas.Left="0" Canvas.Top="20"
                                                  Width="430" Height="440">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="72" />
                                                <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="180" Height="{Binding Height}" Background="{Binding Fill}"
                                                        BorderBrush="#89a9c9" BorderThickness="0,0,0,1" ToolTip="{Binding ToolTip}">
                                                    <TextBlock Text="{Binding Label}" Margin="6,4" Padding="4,1" FontSize="11"
                                                               Foreground="#07141d" Background="#D9EDF7FF"
                                                               HorizontalAlignment="Left" VerticalAlignment="Top"
                                                               MaxWidth="166" TextTrimming="CharacterEllipsis"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="{Binding ViewMessage}" Foreground="#a8c1d9" FontSize="13"
                                               Canvas.Left="270" Canvas.Top="220" Width="150" TextWrapping="Wrap"/>
                                </Canvas>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Visibility="{Binding IsMapViewActive, Converter={StaticResource BoolToVisibility}}"
                        Background="#0f1d2b" BorderBrush="#2c4b65" BorderThickness="1" CornerRadius="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Background="#122840" BorderBrush="#2c4b65" BorderThickness="0,0,0,1" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Plan view — boreholes positioned by X / Y coordinates" Foreground="#a8c1d9" />
                                <TextBlock Text="{Binding MapRangeLabel}" Foreground="#6f8aa3" FontSize="11" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <Grid Margin="24,16" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <Canvas Width="620" Height="480">
                                    <Rectangle Canvas.Left="56" Canvas.Top="28" Width="540" Height="404"
                                               Fill="#0b1a27" Stroke="#2c4b65" StrokeThickness="1" />
                                    <TextBlock Text="Y (m)" Foreground="#a8c1d9" FontSize="11" Canvas.Left="16" Canvas.Top="24" />
                                    <TextBlock Text="X (m)" Foreground="#a8c1d9" FontSize="11" Canvas.Left="582" Canvas.Top="440" />

                                    <ItemsControl ItemsSource="{Binding MapMarkers}" Canvas.Left="0" Canvas.Top="0"
                                                  Width="620" Height="480">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                                <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" ToolTip="{Binding ToolTip}">
                                                    <Ellipse Width="{Binding Size}" Height="{Binding Size}" VerticalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="#0ea5e9" />
                                                                <Setter Property="Stroke" Value="#edf7ff" />
                                                                <Setter Property="StrokeThickness" Value="1" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="Fill" Value="#f59e0b" />
                                                                        <Setter Property="StrokeThickness" Value="2" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding Label}" Foreground="#edf7ff" FontSize="11"
                                                               Margin="6,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="{Binding MapMessage}" Foreground="#a8c1d9" FontSize="13"
                                               Canvas.Left="220" Canvas.Top="220" Width="220" TextWrapping="Wrap" />
                                </Canvas>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Visibility="{Binding IsSectionViewActive, Converter={StaticResource BoolToVisibility}}"
                        Background="#0f1d2b" BorderBrush="#2c4b65" BorderThickness="1" CornerRadius="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Background="#122840" BorderBrush="#2c4b65" BorderThickness="0,0,0,1" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Cross section — lithology columns along the profile, axes in metres" Foreground="#a8c1d9" />
                                <TextBlock Text="{Binding SectionMessage}" Foreground="#6f8aa3" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <Grid Margin="24,16" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <Canvas Width="620" Height="440">
                                    <Rectangle Canvas.Left="78" Canvas.Top="54" Width="514" Height="328"
                                               Fill="#0b1a27" Stroke="#2c4b65" StrokeThickness="1" />
                                    <Polyline Points="{Binding SectionSurfacePoints}" Stroke="#edf7ff" StrokeThickness="2" />
                                    <TextBlock Text="Elevation (m)" Foreground="#a8c1d9" FontSize="11" Canvas.Left="4" Canvas.Top="8" />

                                    <ItemsControl ItemsSource="{Binding SectionColumns}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                                <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="{Binding Width}" Height="{Binding Height}" Background="#0b1a27">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="BorderBrush" Value="#89a9c9" />
                                                            <Setter Property="BorderThickness" Value="1" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="BorderBrush" Value="#f59e0b" />
                                                                    <Setter Property="BorderThickness" Value="2" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <ItemsControl ItemsSource="{Binding Layers}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <Canvas />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemContainerStyle>
                                                            <Style TargetType="ContentPresenter">
                                                                <Setter Property="Canvas.Left" Value="0" />
                                                                <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                                            </Style>
                                                        </ItemsControl.ItemContainerStyle>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Rectangle Height="{Binding Height}"
                                                                           Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Border}}"
                                                                           Fill="{Binding Fill}" ToolTip="{Binding ToolTip}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ItemsControl ItemsSource="{Binding SectionLabels}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                                <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Label}" Width="80" TextAlignment="Center"
                                                           Foreground="#edf7ff" FontSize="11" TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ItemsControl ItemsSource="{Binding SectionDistanceTicks}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                                <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Label}" Width="70" TextAlignment="Center"
                                                           Foreground="#a8c1d9" FontSize="10" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ItemsControl ItemsSource="{Binding SectionElevationTicks}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                                <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Label}" Width="56" TextAlignment="Right"
                                                           Foreground="#a8c1d9" FontSize="10" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Canvas>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>
                </Grid>
            </Grid>

            <Border Grid.Column="2" Background="#0d1b2a" BorderBrush="#2c4b65" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Text="PROPERTIES" Style="{StaticResource PanelLabel}" Margin="0,0,0,10" />

                        <StackPanel IsEnabled="{Binding HasSelectedBorehole}">
                            <TextBlock Text="Borehole name" Foreground="#edf7ff" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding BoreholeName}" Style="{StaticResource FieldBox}" />

                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="X" Foreground="#a8c1d9" VerticalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding BoreholeX, StringFormat=0.##}" Style="{StaticResource FieldBox}" />

                                <TextBlock Grid.Row="1" Text="Y" Foreground="#a8c1d9" VerticalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding BoreholeY, StringFormat=0.##}" Style="{StaticResource FieldBox}" />

                                <TextBlock Grid.Row="2" Text="Elevation (m)" Foreground="#a8c1d9" VerticalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding BoreholeElevation, StringFormat=0.##}" Style="{StaticResource FieldBox}" />

                                <TextBlock Grid.Row="3" Text="Total depth (m)" Foreground="#a8c1d9" VerticalAlignment="Center" Margin="0,0,0,0"/>
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding BoreholeTotalDepth, StringFormat=0.##}" Style="{StaticResource FieldBox}" Margin="0" />
                            </Grid>
                        </StackPanel>

                        <TextBlock Text="LITHOLOGY LAYERS" Style="{StaticResource PanelLabel}" Margin="0,20,0,8" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Add layer" Command="{Binding AddIntervalCommand}" Style="{StaticResource ToolButton}" Width="90" />
                            <Button Content="Remove" Command="{Binding RemoveIntervalCommand}" Style="{StaticResource ToolButton}" Width="80" Margin="0" />
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding LithologyIntervals}"
                                  SelectedItem="{Binding SelectedInterval, Mode=TwoWay}"
                                  IsEnabled="{Binding HasSelectedLog}"
                                  Height="180" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  CanUserReorderColumns="False" CanUserResizeRows="False" HeadersVisibility="Column"
                                  GridLinesVisibility="None" RowHeight="26" Background="#0e1a29" RowBackground="#0e1a29"
                                  AlternatingRowBackground="#122840" Foreground="#edf7ff" BorderBrush="#2c4b65"
                                  HorizontalGridLinesBrush="#2c4b65" VerticalGridLinesBrush="#2c4b65">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#122840" />
                                    <Setter Property="Foreground" Value="#a8c1d9" />
                                    <Setter Property="BorderBrush" Value="#2c4b65" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                    <Setter Property="Padding" Value="6,4" />
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="#0e1a29" />
                                    <Setter Property="Foreground" Value="#edf7ff" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#1d3b55" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="#edf7ff" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Padding" Value="4,2" />
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="From" Binding="{Binding StartDepth, StringFormat=0.##}"
                                                    Width="56" EditingElementStyle="{StaticResource GridEditingBox}" />
                                <DataGridTextColumn Header="To" Binding="{Binding EndDepth, StringFormat=0.##}"
                                                    Width="56" EditingElementStyle="{StaticResource GridEditingBox}" />
                                <DataGridTextColumn Header="Lithology" Binding="{Binding Lithology, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="*" EditingElementStyle="{StaticResource GridEditingBox}" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="IMPORTED CSV TABLES" Style="{StaticResource PanelLabel}" Margin="0,18,0,8" />
                        <ListBox ItemsSource="{Binding ImportedTables}" SelectedItem="{Binding SelectedImportedTable, Mode=TwoWay}"
                                 DisplayMemberPath="Name" Height="80" Background="#0e1a29" BorderBrush="#2c4b65" Foreground="#edf7ff"/>
                        <TextBlock Text="ROWS" Style="{StaticResource PanelLabel}" Margin="0,12,0,6" />
                        <ListBox ItemsSource="{Binding ImportedRowPreviews}" Height="150" Background="#0e1a29" BorderBrush="#2c4b65" Foreground="#edf7ff"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#0b1724" BorderBrush="#2c4b65" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#a8c1d9" VerticalAlignment="Center" Margin="14,0,0,0"/>
        </Border>
    </Grid>
</Window>
