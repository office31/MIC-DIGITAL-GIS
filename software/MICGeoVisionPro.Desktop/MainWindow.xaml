<Window x:Class="MICGeoVisionPro.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MIC GeoVision Pro" Height="720" Width="1280" WindowStartupLocation="CenterScreen" Background="#07141d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="54" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0b1724" BorderBrush="#2c4b65" BorderThickness="0,0,0,1">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" Background="#0ea5e9" CornerRadius="8" VerticalAlignment="Center">
                        <TextBlock Text="MIC" FontWeight="Bold" Foreground="#041821" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10"/>
                    </Border>
                    <TextBlock Text="MIC GeoVision Pro" Margin="12,0,0,0" FontSize="20" FontWeight="Bold" Foreground="#edf7ff" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="New Project" Width="110" Margin="0,0,8,0" Height="30" Background="#112230" Foreground="#edf7ff" BorderBrush="#2c4b65"/>
                    <Button Content="Import" Width="90" Height="30" Background="#112230" Foreground="#edf7ff" BorderBrush="#2c4b65"/>
                    <Button Content="Export" Width="90" Height="30" Margin="8,0,0,0" Background="#112230" Foreground="#edf7ff" BorderBrush="#2c4b65"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <Border Background="#0d1b2a" BorderBrush="#2c4b65" BorderThickness="0,0,1,0">
                <StackPanel Margin="12,12,10,12">
                    <TextBlock Text="PROJECT" FontSize="11" Foreground="#a8c1d9" FontWeight="Bold" Margin="0,0,0,12"/>
                    <TextBox Text="MIC GIS Demo" Height="30" Margin="0,0,0,18" Background="#112230" Foreground="#edf7ff" BorderBrush="#2c4b65"/>

                    <TextBlock Text="BOREHOLES" FontSize="11" Foreground="#a8c1d9" FontWeight="Bold" Margin="0,0,0,10"/>
                    <ListBox Height="140" Background="#0e1a29" BorderBrush="#2c4b65" Foreground="#edf7ff">
                        <ListBoxItem Content="B-01" IsSelected="True"/>
                        <ListBoxItem Content="B-02"/>
                        <ListBoxItem Content="B-03"/>
                    </ListBox>

                    <TextBlock Text="LOGS" FontSize="11" Foreground="#a8c1d9" FontWeight="Bold" Margin="18,18,0,10"/>
                    <ListBox Height="140" Background="#0e1a29" BorderBrush="#2c4b65" Foreground="#edf7ff">
                        <ListBoxItem Content="Lithology Log" IsSelected="True"/>
                        <ListBoxItem Content="Depth Log"/>
                        <ListBoxItem Content="Bar Log"/>
                    </ListBox>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1" Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Background="#112230" BorderBrush="#2c4b65" BorderThickness="1" CornerRadius="10" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="CURRENT VIEW" FontSize="11" Foreground="#a8c1d9" FontWeight="Bold"/>
                            <TextBlock Text="Borehole View" FontSize="24" FontWeight="Bold" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Borehole" Width="90" Height="30" Background="#0ea5e9" Foreground="#041821" Margin="0,0,8,0"/>
                            <Button Content="Map" Width="70" Height="30" Background="#112230" Foreground="#edf7ff" BorderBrush="#2c4b65"/>
                            <Button Content="Cross Section" Width="110" Height="30" Margin="8,0,0,0" Background="#112230" Foreground="#edf7ff" BorderBrush="#2c4b65"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Margin="0,12,0,0" Background="#0f1d2b" BorderBrush="#2c4b65" BorderThickness="1" CornerRadius="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Background="#122840" BorderBrush="#2c4b65" BorderThickness="0,0,0,1" Padding="12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Depth" Foreground="#a8c1d9" VerticalAlignment="Center"/>
                                <TextBox Width="120" Margin="10,0,0,0" Height="28" Background="#0d1b2a" Foreground="#edf7ff" BorderBrush="#2c4b65"/>
                                <TextBlock Text="Elevation" Foreground="#a8c1d9" VerticalAlignment="Center" Margin="18,0,0,0"/>
                                <TextBox Width="120" Margin="10,0,0,0" Height="28" Background="#0d1b2a" Foreground="#edf7ff" BorderBrush="#2c4b65"/>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="1" Margin="16">
                            <Grid.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#15314a" Offset="0"/>
                                    <GradientStop Color="#102739" Offset="1"/>
                                </LinearGradientBrush>
                            </Grid.Background>

                            <Canvas Width="Auto" Height="Auto">
                                <Rectangle Width="620" Height="360" Canvas.Left="30" Canvas.Top="30" Fill="#183146" Stroke="#89a9c9" StrokeThickness="1"/>
                                <Rectangle Width="180" Height="360" Canvas.Left="40" Canvas.Top="30" Fill="#1c3d59" Stroke="#89a9c9" StrokeThickness="1"/>
                                <Rectangle Width="260" Height="360" Canvas.Left="220" Canvas.Top="30" Fill="#224a6b" Stroke="#89a9c9" StrokeThickness="1"/>
                                <Rectangle Width="180" Height="360" Canvas.Left="480" Canvas.Top="30" Fill="#1a4162" Stroke="#89a9c9" StrokeThickness="1"/>

                                <Rectangle Width="560" Height="30" Canvas.Left="40" Canvas.Top="90" Fill="#2f7db6" Opacity="0.75"/>
                                <Rectangle Width="560" Height="32" Canvas.Left="40" Canvas.Top="160" Fill="#5eb4d8" Opacity="0.7"/>
                                <Rectangle Width="560" Height="25" Canvas.Left="40" Canvas.Top="235" Fill="#7cc8b1" Opacity="0.7"/>
                                <Rectangle Width="560" Height="80" Canvas.Left="40" Canvas.Top="295" Fill="#c4a57d" Opacity="0.7"/>

                                <Line X1="40" Y1="30" X2="40" Y2="390" Stroke="#dfeaf5" StrokeThickness="2"/>
                                <Line X1="40" Y1="390" X2="600" Y2="390" Stroke="#dfeaf5" StrokeThickness="2"/>
                            </Canvas>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="2" Background="#0d1b2a" BorderBrush="#2c4b65" BorderThickness="1,0,0,0">
                <StackPanel Margin="12">
                    <TextBlock Text="PROPERTIES" FontSize="11" Foreground="#a8c1d9" FontWeight="Bold" Margin="0,0,0,12"/>

                    <TextBlock Text="Borehole" Foreground="#edf7ff" Margin="0,8,0,4" FontWeight="Bold"/>
                    <TextBox Text="B-01" Height="28" Background="#112230" BorderBrush="#2c4b65" Foreground="#edf7ff"/>

                    <TextBlock Text="Coordinates" Foreground="#edf7ff" Margin="0,16,0,4" FontWeight="Bold"/>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="500.00" Height="28" Margin="0,0,6,0" Background="#112230" BorderBrush="#2c4b65" Foreground="#edf7ff"/>
                        <TextBox Grid.Column="1" Text="600.00" Height="28" Margin="6,0,0,0" Background="#112230" BorderBrush="#2c4b65" Foreground="#edf7ff"/>
                    </Grid>

                    <TextBlock Text="Total Depth" Foreground="#edf7ff" Margin="0,16,0,4" FontWeight="Bold"/>
                    <TextBox Text="76.00" Height="28" Background="#112230" BorderBrush="#2c4b65" Foreground="#edf7ff"/>

                    <TextBlock Text="Log Type" Foreground="#edf7ff" Margin="0,16,0,4" FontWeight="Bold"/>
                    <ComboBox Height="30" SelectedIndex="0" Background="#112230" BorderBrush="#2c4b65" Foreground="#edf7ff">
                        <ComboBoxItem Content="Lithology"/>
                        <ComboBoxItem Content="Depth"/>
                        <ComboBoxItem Content="Bar"/>
                    </ComboBox>

                    <Button Content="Apply" Width="120" Height="34" Margin="0,24,0,0" Background="#0ea5e9" Foreground="#041821" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#0b1724" BorderBrush="#2c4b65" BorderThickness="0,1,0,0">
            <TextBlock Text=" Ready  |  Project loaded  |  3 logs available  |  Demo mode" Foreground="#a8c1d9" VerticalAlignment="Center" Margin="14,0,0,0"/>
        </Border>
    </Grid>
</Window>
